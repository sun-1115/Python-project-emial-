# GitHub personal access token (https://github.com/settings/tokens)
# A classic token with "read:user" scope, or a fine-grained token, is enough.
GITHUB_TOKEN=

# --- Seed search: which UK users to START from ---
# The seed search is UK-biased; users discovered later via repositories are saved
# regardless of location (including users with no location).
#
# Locations are free-text on GitHub, so we search MANY variants and merge.
# SEARCH_LOCATIONS (comma list) takes priority. If unset, SEARCH_LOCATION is used.
# If BOTH are empty, a built-in list of UK nations/counties/cities is used automatically.
SEARCH_LOCATIONS=United Kingdom, UK, England, Scotland, Wales, Northern Ireland, London, Manchester, Birmingham, Edinburgh, Bristol, Cambridge
SEARCH_LOCATION=

# Optional: restrict/expand seeds by language. Comma list; invalid names are ignored.
# Each (location x language) becomes a separate search (beats GitHub's 1000/query cap).
SEARCH_LANGUAGE=javascript, typescript, python, go, rust

# Optional extra seed filters
SEARCH_MIN_FOLLOWERS=
SEARCH_MIN_REPOS=
SEARCH_EXTRA=
SEARCH_SORT=followers
SEARCH_ORDER=desc

# Max seed users to collect from the search stage (before the repo crawl expands it)
MAX_USERS=50

# --- Collaboration crawl (find other users via repositories) ---
# For each seed user: list their non-fork repos, then each repo's contributors,
# and save those contributors as users too. One hop only (no recursion).
CRAWL_ENABLED=true
MAX_REPOS_PER_USER=30          # non-fork repos to inspect per seed user
MAX_CONTRIBUTORS_PER_REPO=30   # contributors to pull from each repo
MAX_TOTAL_USERS=1000           # hard cap on users saved per run (runaway guard)

# --- Scheduling ---
CRON_SCHEDULE=0 3 * * *
RUN_ON_START=true

# Only save users with a real profile picture (skip GitHub's default identicon).
# REQUIRE_AVATAR=true

# --- Storage & UI ---
DB_PATH=./data/github-users.db
UI_PORT=1002

# --- Email bot (Gmail API, send-only, multi-account) ---
# Provide EITHER credentials.json (OAuth Desktop client) OR these two env vars.
# One OAuth client authorizes all 10 accounts; each account gets its own token.
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
# Optional overrides (defaults shown):
# GMAIL_CREDENTIALS_PATH=./credentials.json
# EMAIL_TOKENS_DIR=./tokens            # holds token-<label>.json, one per account

# Sending window — evaluated in this timezone (recipients are UK GitHub users).
# EMAIL_TIMEZONE=Europe/London
# EMAIL_SEND_START_HOUR=9              # inclusive
# EMAIL_SEND_END_HOUR=18              # exclusive
# EMAIL_SEND_DAYS=1,2,3,4,5           # 1=Mon … 5=Fri (weekdays only)

# Volume — every account starts at the cap below; the 5→10→15 warm-up ramp is opt-in.
# EMAIL_WARMUP_RAMP=false             # true = ease new accounts up over ~4 weeks
# EMAIL_CAP_JITTER=3                  # daily cap varies 0..2 below the cap; 0 = exact
# EMAIL_DAILY_CAP=20                  # steady-state cap per account per day
# EMAIL_MIN_GAP_MIN=15               # min minutes between one account's sends
# EMAIL_MAX_GAP_MIN=30               # max minutes between one account's sends


# Message templates — folder of .txt/.md files; ONE is picked at random per send.
# EMAIL_MESSAGES_DIR=./messages
# Default subject when a template has no "Subject:" line (used by the UI loop).
# EMAIL_SUBJECT=Hi {{name|there}}
# Greeting prepended to every body at send time (templates stay greeting-free).
# Profile names are cleaned first — honorifics, credentials, "(nicknames)" and
# company/role labels are stripped, and anything that isn't a personal name
# falls back to "there". Set empty to send no greeting. {{firstName|there}} works too.
# EMAIL_GREETING=Hi {{name|there}},
# Send text + HTML so Gmail lays the message out as normal paragraphs instead of
# its fixed-width plain-text column. Set to false for text-only.
# EMAIL_HTML=true
